-- Populate direct top-level index for fast lookups: RelicConfig[itemId]
for id, item in pairs(RelicConfig.Items) do
	RelicConfig[id] = item
end

-- Helper: Retrieve biome configuration for a given tower floor ID (1..50)
function RelicConfig.GetBiomeForFloor(floorId: number): any?
	for _, biome in ipairs(RelicConfig.Biomes) do
		if floorId >= biome.FloorRange[1] and floorId <= biome.FloorRange[2] then
			return biome
		end
	end
	return nil
end

-- Helper: Retrieve item specification by ID
function RelicConfig.GetItem(itemId: string): any?
	return RelicConfig.Items[itemId] or RelicConfig[itemId]
end

-- Helper: Retrieve all relic item specs belonging to a biome (1..10)
function RelicConfig.GetBiomeRelics(biomeIndex: number): { any }
	local biome = RelicConfig.Biomes[biomeIndex]
	if not biome then
		return {}
	end
	local relics = {}
	for _, relicId in ipairs(biome.DropTable) do
		local item = RelicConfig.Items[relicId]
		if item then
			table.insert(relics, item)
		end
	end
	return relics
end

return RelicConfig
