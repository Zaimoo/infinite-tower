-- True when every mesh of the boss has an uploaded MeshId (otherwise the stand-in rig is used).
function Assets.HasMeshes(bossId: string): boolean
	local boss = Assets.Bosses[bossId]
	if not boss then return false end
	for _, s in boss.Segments do
		if s.Mesh and s.MeshId == "" then return false end
		for _, g in s.Glow do if g.MeshId == "" then return false end end
	end
	return true
end

return Assets
