--!strict
-- ReplicatedStorage/Shared/Config/SoundCatalog.luau
-- Authoritative catalog of all sound effects, background fantasy music, and ambient loops.
-- Each entry defines its uploaded asset ID, optional local Anime SFX Pack reference
-- (`SourceFile` / `StudioId` / `Variants`), audio category (SFX, Music, Ambience),
-- volume balance, pitch variance, roll-off distance, spam throttle, and slice envelope
-- (`TimeOffset`, `MaxDuration`, `FadeOutSeconds`).

local AnimeSfxManifest = require(script.Parent.AnimeSfxManifest)

export type SoundDefinition = {
	Id: string,
	StudioId: string?,
	SourceFile: string?,
	Variants: { string }?,
	Category: "SFX" | "Music" | "Ambience",
	Volume: number,
	Pitch: number?,
	PitchVariance: number?,
	RollOffMin: number?,
	RollOffMax: number?,
	Cooldown: number?,
	TimeOffset: number?,
	MaxDuration: number?,
	FadeOutSeconds: number?,
	MaxVoices: number?, -- overlapping copies allowed at once (AudioManager default 4)
}

local SoundCatalog = {}

local function freezeCatalog(entries: { [string]: SoundDefinition }): { [string]: SoundDefinition }
	for key, def in pairs(entries) do
		if def.SourceFile and def.SourceFile ~= "" then
			local studioId = AnimeSfxManifest.GetStudioId(def.SourceFile)
			assert(studioId ~= nil, ("SoundCatalog entry '%s' references unknown SourceFile '%s'"):format(key, def.SourceFile))
			if not def.StudioId or def.StudioId == "" then
				def.StudioId = studioId
			end
		end
		if def.Variants then
			for _, variantKey in ipairs(def.Variants) do
				local variantId = AnimeSfxManifest.GetStudioId(variantKey)
				assert(variantId ~= nil, ("SoundCatalog entry '%s' references unknown Variant '%s'"):format(key, variantKey))
			end
			table.freeze(def.Variants)
		end
		table.freeze(def)
	end
	return table.freeze(entries)
end

